# Copy to .env (git-ignored) and fill in. Read by compose.yml.

# Postgres for this app only; any long random string.
POSTGRES_PASSWORD=

# The first admin account, made at the first boot (it also receives data stored
# before accounts existed). Later passwords are changed in the app (Profil);
# changing these values afterwards does not change the account. Required: the
# server refuses to start on a public address without APP_PASSWORD.
APP_USER=admin
APP_PASSWORD=

# Host port the app listens on (127.0.0.1 only).
APP_PORT=8410

# LLM keys, as in the repository's .env.example. Only set what you use.
OPENAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# What a browser with nothing remembered starts with (provider, models, and the
# endpoint for that provider, so nobody has to type it). The URL applies only to
# this provider; a user who picks another provider gets that provider's endpoint.
# TRADINGAGENTS_LLM_PROVIDER=openai_compatible
# TRADINGAGENTS_QUICK_THINK_LLM=
# TRADINGAGENTS_DEEP_THINK_LLM=
# TRADINGAGENTS_LLM_BACKEND_URL=

# The worker sends the provider key to the backend URL a request names, so
# accept only these (comma-separated). Empty = any URL.
ALLOWED_BACKEND_URLS=

# Daily caps on what spends LLM credits, per day in WIB (0 = no cap). A backtest
# counts every cell, since each cell is a full analysis. DAILY_* is each user's
# default (the admin can set another per user); DAILY_TOTAL_* caps all users together.
DAILY_ANALYSIS_LIMIT=60
DAILY_CHAT_LIMIT=300
DAILY_TOTAL_ANALYSIS_LIMIT=200
DAILY_TOTAL_CHAT_LIMIT=1000

# Watchlist: symbols starred in the app are analysed automatically on these ISO
# weekdays (1 = Monday) at this time, WIB, using the default model above. Each
# symbol uses one of the daily analyses.
WATCH_TIME=16:30
WATCH_DAYS=1-5
# WATCH_ANALYSTS=market,social,news,fundamentals
# WATCH_DEPTH=1
# Summary of each run to Telegram, through one bot (token from @BotFather). Each
# user enters their own chat id in Profil; TELEGRAM_CHAT_ID only seeds the first
# admin's. Leave the token empty to skip Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The app's public address, for links in the Telegram message.
PUBLIC_URL=
# Signal notifications: a signal first seen more than this many bars late is recorded, not sent.
# SIGNAL_STALE_BARS=4

# Optional tuning (defaults shown).
# MAX_CONCURRENT_ANALYSES=2
# MAX_BACKTEST_CELLS=40
# JOB_IDLE_MINUTES=15
# TA_LLM_TIMEOUT=180
# TA_LLM_MAX_RETRIES=2
# TA_AGENT_LLM_TIMEOUT=120
